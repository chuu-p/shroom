[Unit]
Description=shroom daemon
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/home/chuu/.nix-profile/bin/shroomd
Restart=always
RestartSec=3
User=root
Group=root
Environment=PATH=/home/chuu/.nix-profile/bin:/usr/bin:/bin
Environment=HOME=/root

[Install]
WantedBy=multi-user.target
